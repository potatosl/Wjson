// SPDX-License-Identifier: MPL-2.0
//
// Prints examples/data/survey_sample.json (made by csv2json.wave) as a table,
// reading everything through wjson. Numbers are shown exactly as stored.
//
//   WJSON_RUN=examples/show_data.wave wavec run build.wave

import("std::fs::file")::{fs_read_all, fs_file_size};
import("std::mem::alloc")::{mem_alloc, mem_free};
import("wjson")::{
    wjson_console_utf8,
    JsonDoc, Json, json_parse_bytes, json_ok, json_root, json_free, json_len, json_at,
    json_get, json_str_or, json_number_text, json_str_eq, json_key_at, json_str_is_null,
    json_path_i64,
};

const INPUT: str = "data/survey_sample.json";

// Terminal width of UTF-8 text: Hangul and other wide CJK = 2 columns.
fun display_width(s: str) -> i64 {
    var p: ptr<u8> = s as ptr<u8>;
    if (p == null) {
        return 0;
    }
    var i: i64 = 0;
    var w: i64 = 0;
    while (p[i] != 0) {
        var b: u8 = p[i];
        if (b < 128) {
            w += 1;
            i += 1;
        } else if (b >= 240) {
            w += 2;
            i += 4;
        } else if (b >= 224) {
            // U+1100.. (Hangul, CJK) lead bytes E1..ED are wide; '·' etc. are not.
            if (b >= 225 && b <= 237) {
                w += 2;
            } else {
                w += 1;
            }
            i += 3;
        } else {
            w += 1;
            i += 2;
        }
    }
    return w;
}

fun spaces(n: i64) {
    var i: i64 = 0;
    while (i < n) {
        print(" ");
        i += 1;
    }
}

fun cell_left(s: str, width: i64) {
    print("{}", s);
    spaces(width - display_width(s));
}

fun cell_right(s: str, width: i64) {
    spaces(width - display_width(s));
    print("{}", s);
}

fun rule(width: i64) {
    var i: i64 = 0;
    while (i < width) {
        print("-");
        i += 1;
    }
    println("");
}

// Subtotal ("소계") of one measure group, as written in the source.
fun subtotal(row: Json, group: str) -> str {
    var text: str = json_number_text(json_get(json_get(row, group), "소계"));
    if (json_str_is_null(text)) {
        return "-";
    }
    return text;
}

fun main() -> i32 {
    wjson_console_utf8();
    var size: i64 = fs_file_size(INPUT);
    if (size < 0) {
        println("{} not found - run csv2json.wave first", INPUT);
        return 1;
    }
    var data: ptr<u8> = mem_alloc(size);
    var n: i64 = fs_read_all(INPUT, data, size);
    var doc: JsonDoc = json_parse_bytes(data, n, 0, 0);
    mem_free(data, size);
    if (!json_ok(doc)) {
        println("{} is not valid JSON", INPUT);
        return 1;
    }
    var root: Json = json_root(doc);
    var rows: Json = json_get(root, "rows");
    var measures: Json = json_get(root, "measures");

    println("{} 기준 · {}개 행 · 측정 항목 {}개 (값은 소계, 단위 %)",
            json_path_i64(root, "year", 0), json_len(rows), json_len(measures));
    println("");

    // Header: dimension column, firm count, then one column per % group.
    var labels: array<str, 7> = ["기업체수", "매출증대", "채산성", "다각화", "작업환경", "에너지", "인증"];
    cell_left("구분", 44);
    var h: i64 = 0;
    while (h < 7) {
        cell_right(labels[h], 10);
        h += 1;
    }
    println("");
    rule(44 + 70);

    var i: i64 = 0;
    while (i < json_len(rows)) {
        var row: Json = json_at(rows, i);
        var d1: str = json_str_or(json_get(row, "특성별(1)"), "?");
        var d2: str = json_str_or(json_get(row, "특성별(2)"), "?");
        var d3: str = json_str_or(json_get(row, "특성별(3)"), "?");

        // Blank line before each top-level section.
        if (json_str_eq(json_get(row, "특성별(2)"), "소계") && i > 0) {
            println("");
        }

        if (json_str_eq(json_get(row, "특성별(2)"), "소계")) {
            cell_left(d1, 44);
        } else {
            print("  ");
            print("{} > ", d2);
            cell_left(d3, 44 - 2 - display_width(d2) - 3);
        }

        var g: i64 = 0;
        while (g < json_len(measures)) {
            var name: str = json_str_or(json_get(json_at(measures, g), "name"), "?");
            cell_right(subtotal(row, name), 10);
            g += 1;
        }
        println("");
        i += 1;
    }
    rule(44 + 70);

    // Full detail for the first row, every measure item.
    println("");
    println("[전체] 세부 항목");
    var first: Json = json_at(rows, 0);
    var m: i64 = 0;
    while (m < json_len(measures)) {
        var group: Json = json_at(measures, m);
        var gname: str = json_str_or(json_get(group, "name"), "?");
        println("  {}", gname);
        var items: Json = json_get(group, "items");
        var k: i64 = 0;
        while (k < json_len(items)) {
            var item: str = json_str_or(json_at(items, k), "?");
            print("      ");
            cell_left(item, 30);
            var cell: str = json_number_text(json_get(json_get(first, gname), item));
            if (json_str_is_null(cell)) {
                cell = "-";
            }
            cell_right(cell, 8);
            println("");
            k += 1;
        }
        m += 1;
    }

    json_free(&doc);
    return 0;
}
