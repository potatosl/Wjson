// SPDX-License-Identifier: MPL-2.0
//
// Differential test for the pure-Wave pull parser (src/core_stream.wave)
// against the Rust core (core/src/stream.rs, reached through its C ABI). Both
// readers get the same input in the same chunks and are stepped in lockstep:
// every event, the text that goes with it, the depth, the number of buffered
// bytes and the document count must match, and so must the error code, offset,
// line and column when the input is bad. Valid, relaxed, multi-document and
// damaged inputs are fed whole, byte by byte, in fixed sizes and in random
// chunks. The token-size cap is checked too.
// Run from the repository root:  wavec run build.wave

import("std::mem::alloc")::{mem_alloc, mem_free};
extern(c, "getenv") fun c_getenv(name: ptr<u8>) -> ptr<u8>;
import("wjson::ffi")::{
    ffi_reader_new, ffi_reader_free, ffi_reader_set_max_token, ffi_reader_feed, ffi_reader_finish,
    ffi_reader_next, ffi_reader_text, ffi_reader_depth, ffi_reader_documents, ffi_reader_buffered,
    ffi_reader_error_code, ffi_reader_error_offset, ffi_reader_error_line, ffi_reader_error_column,
};
import("wjson::core_stream")::{
    CoreReader, core_reader_new, core_reader_free, core_reader_set_max_token, core_reader_feed,
    core_reader_finish, core_reader_next, core_reader_text, core_reader_depth, core_reader_documents,
    core_reader_buffered, core_reader_error_code, core_reader_error_offset, core_reader_error_line,
    core_reader_error_column,
};

static CHECKS: i32 = 0;
static FAILURES: i32 = 0;
static RNG: u64 = 88172645463325252;

fun check(cond: bool, label: str) {
    CHECKS += 1;
    if (!cond) {
        FAILURES += 1;
        if (FAILURES <= 20) {
            println("FAIL: {}", label);
        }
    }
}

fun next() -> u64 {
    var x: u64 = RNG;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    RNG = x;
    return x * 2685821657736338717;
}

fun below(n: u64) -> u64 {
    return (next() >> 11) % n;
}

fun len_of(s: str) -> i64 {
    var p: ptr<u8> = s as ptr<u8>;
    var n: i64 = 0;
    while (p[n] != 0) {
        n += 1;
    }
    return n;
}

fun same_text(a: ptr<u8>, la: i64, b: ptr<u8>, lb: i64) -> bool {
    if (la != lb) {
        return false;
    }
    var i: i64 = 0;
    while (i < la) {
        if (a[i] != b[i]) {
            return false;
        }
        i += 1;
    }
    return a[la] == 0 && b[la] == 0;
}

// Feeds the input in chunks and steps both readers in lockstep. chunk > 0 is a
// fixed size, chunk == 0 feeds everything at once, chunk < 0 uses random sizes
// up to -chunk. Returns the number of events compared.
fun agree(src: ptr<u8>, n: i64, depth: i32, flags: u32, chunk: i64, max_token: i64, label: str) -> i64 {
    var r: ptr<u8> = ffi_reader_new(depth, flags);
    var w: CoreReader = core_reader_new(depth, flags);
    if (max_token > 0) {
        ffi_reader_set_max_token(r, max_token);
        core_reader_set_max_token(&w, max_token);
    }
    var fed: i64 = 0;
    var events: i64 = 0;
    var ok: bool = true;
    var guard: i64 = 0;
    while (ok && guard < 4 * n + 64) {
        guard += 1;
        var er: i32 = ffi_reader_next(r);
        var ew: i32 = core_reader_next(&w);
        events += 1;
        if (er != ew) {
            check(false, label);
            if (FAILURES <= 20) {
                println("   input {} bytes, chunk {}: rust event {} wave event {} (fed {})", n, chunk, er, ew, fed);
            }
            ok = false;
        } else {
            var lr: i64 = 0;
            var lw: i64 = 0;
            var tr: ptr<u8> = ffi_reader_text(r, &lr);
            var tw: ptr<u8> = core_reader_text(&w, &lw);
            var same: bool = ffi_reader_depth(r) == core_reader_depth(&w)
                && ffi_reader_buffered(r) == core_reader_buffered(&w)
                && ffi_reader_documents(r) == core_reader_documents(&w);
            if (er == 5 || er == 6 || er == 7) {
                same = same && same_text(tr, lr, tw, lw);
            }
            if (er == 0 - 1) {
                same = same && ffi_reader_error_code(r) == core_reader_error_code(&w)
                    && ffi_reader_error_offset(r) == core_reader_error_offset(&w)
                    && ffi_reader_error_line(r) == core_reader_error_line(&w)
                    && ffi_reader_error_column(r) == core_reader_error_column(&w);
            }
            check(same, label);
            if (!same) {
                if (FAILURES <= 20) {
                    println("   input {} bytes, chunk {}, event {}: depth {}/{} buffered {}/{} docs {}/{}", n, chunk, er,
                            ffi_reader_depth(r), core_reader_depth(&w), ffi_reader_buffered(r), core_reader_buffered(&w),
                            ffi_reader_documents(r), core_reader_documents(&w));
                    if (er == 0 - 1) {
                        println("   rust: code {} offset {} line {} col {}   wave: code {} offset {} line {} col {}",
                                ffi_reader_error_code(r), ffi_reader_error_offset(r), ffi_reader_error_line(r), ffi_reader_error_column(r),
                                core_reader_error_code(&w), core_reader_error_offset(&w), core_reader_error_line(&w), core_reader_error_column(&w));
                    }
                }
                ok = false;
            } else if (er == 0 - 1 || er == 11) {
                ok = false;
            } else if (er == 0) {
                if (fed < n) {
                    var step: i64 = chunk;
                    if (chunk == 0) {
                        step = n;
                    } else if (chunk < 0) {
                        step = 1 + (below((0 - chunk) as u64) as i64);
                    }
                    if (fed + step > n) {
                        step = n - fed;
                    }
                    var fr: i32 = ffi_reader_feed(r, src + fed, step);
                    var fw: i32 = core_reader_feed(&w, src + fed, step);
                    check(fr == fw, label);
                    fed += step;
                } else {
                    ffi_reader_finish(r);
                    core_reader_finish(&w);
                    // Feeding after finish is refused by both.
                    check(ffi_reader_feed(r, src, 0) == core_reader_feed(&w, src, 0), label);
                }
            }
        }
    }
    check(!ok, label);
    ffi_reader_free(r);
    core_reader_free(&w);
    return events;
}

// All feeding strategies for one input.
fun agree_all(src: ptr<u8>, n: i64, depth: i32, flags: u32, label: str) {
    agree(src, n, depth, flags, 0, 0, label);
    agree(src, n, depth, flags, 1, 0, label);
    agree(src, n, depth, flags, 2, 0, label);
    agree(src, n, depth, flags, 3, 0, label);
    agree(src, n, depth, flags, 7, 0, label);
    agree(src, n, depth, flags, 0 - 9, 0, label);
    agree(src, n, depth, flags, 0 - 40, 0, label);
}

fun agree_str(s: str, flags: u32) {
    agree_all(s as ptr<u8>, len_of(s), 0, flags, s);
}

fun test_fixed() {
    var f: u32 = 0;
    while (f < 8) {
        agree_str("null", f);
        agree_str("true", f);
        agree_str("false", f);
        agree_str("0", f);
        agree_str("-0", f);
        agree_str("-12.5e+3", f);
        agree_str("1E5", f);
        agree_str("\"\"", f);
        agree_str("\"abc\"", f);
        agree_str("\"a\\n\\t\\\"\\\\\\/\\b\\f\\r\"", f);
        agree_str("\"\\u00e9\\u20ac\\ud83d\\ude00\"", f);
        agree_str("\"\\u0000\"", f);
        agree_str("\"é😀日本\"", f);
        agree_str("[]", f);
        agree_str("{}", f);
        agree_str("[1,2,3]", f);
        agree_str("{\"a\":1,\"b\":[true,false,null],\"c\":{\"d\":\"e\"}}", f);
        agree_str("  [ 1 , { \"k\" : [ ] } ]  ", f);
        agree_str("{\"a\":1,\"a\":2}", f);
        agree_str("[1,]", f);
        agree_str("{\"a\":1,}", f);
        agree_str("[,]", f);
        agree_str("// c\n[1] // d", f);
        agree_str("/* c */ {\"a\" /* x */ : /* y */ 1}", f);
        agree_str("/* unterminated", f);
        agree_str("/ x", f);
        agree_str("[1 /", f);
        // Invalid inputs.
        agree_str("", f);
        agree_str("   ", f);
        agree_str("nul", f);
        agree_str("nulx", f);
        agree_str("tru", f);
        agree_str("falsy", f);
        agree_str("01", f);
        agree_str("-", f);
        agree_str("1.", f);
        agree_str("1e", f);
        agree_str("1e+", f);
        agree_str(".5", f);
        agree_str("+1", f);
        agree_str("\"abc", f);
        agree_str("\"a\\", f);
        agree_str("\"a\\x\"", f);
        agree_str("\"\\u12\"", f);
        agree_str("\"\\ud83d\"", f);
        agree_str("\"\\ud83dx\"", f);
        agree_str("\"\\ude00\"", f);
        agree_str("\"\\ud83d\\u0041\"", f);
        agree_str("\"\\uZZZZ\"", f);
        agree_str("\"tab\there\"", f);
        agree_str("\"nl\nhere\"", f);
        agree_str("[1 2]", f);
        agree_str("{\"a\" 1}", f);
        agree_str("{\"a\":}", f);
        agree_str("{1:2}", f);
        agree_str("{\"a\":1 \"b\":2}", f);
        agree_str("[1,2", f);
        agree_str("{\"a\":1", f);
        agree_str("1 2", f);
        agree_str("[] x", f);
        agree_str("\xef\xbb\xbf[1]", f);                 // BOM
        agree_str("\xef\xbb\xbf", f);                     // BOM only
        agree_str("\"\xff\"", f);
        agree_str("\"\xc3\"", f);
        agree_str("\"\xe2\x82\"", f);
        agree_str("\"\xed\xa0\x80\"", f);
        agree_str("\"ok\xc0\xafbad\"", f);
        agree_str("\xff", f);
        agree_str("[1,\n2,\n\"é\" x]", f);
        agree_str("\n\n   @", f);
        // Several top-level values (an error unless MULTI is set).
        agree_str("1 2 3", f);
        agree_str("{} []\n\"a\" null", f);
        agree_str("{\"a\":1}\n{\"a\":2}\n", f);
        agree_str("1\n2\n/* c */ 3 // d\n", f);
        agree_str("[1][2]", f);
        agree_str("truefalse", f);
        agree_str("1 2 x", f);
        agree_str("12 ", f);
        agree_str("\"a\"\"b\"", f);
        f += 1;
    }
}

fun test_depth() {
    var buf: ptr<u8> = mem_alloc(5000);
    var depths: array<i32, 6> = [1, 3, 512, 513, 2048, 2049];
    var k: i32 = 0;
    while (k < 6) {
        var n: i32 = depths[k];
        var i: i32 = 0;
        while (i < n) {
            deref buf[i] = 91;
            deref buf[n + i] = 93;
            i += 1;
        }
        var total: i64 = (n * 2) as i64;
        agree(buf, total, 0, 0, 0, 0, "nested default");
        agree(buf, total, 2, 0, 1, 0, "nested max_depth 2");
        agree(buf, total, 600, 0, 0 - 50, 0, "nested max_depth 600");
        agree(buf, total, 100000, 4, 0, 0, "nested max_depth clamped");
        k += 1;
    }
    mem_free(buf, 5000);
}

// A token that never ends must hit the cap at the same moment in both readers.
fun test_max_token() {
    var buf: ptr<u8> = mem_alloc(4096);
    var i: i64 = 0;
    deref buf[0] = 91;
    deref buf[1] = 34;
    i = 2;
    while (i < 3000) {
        deref buf[i] = 97;
        i += 1;
    }
    var caps: array<i64, 5> = [1, 10, 100, 2999, 5000];
    var c: i32 = 0;
    while (c < 5) {
        agree(buf, 3000, 0, 0, 1, caps[c], "max_token string");
        agree(buf, 3000, 0, 0, 64, caps[c], "max_token string chunked");
        agree(buf, 3000, 0, 0, 0, caps[c], "max_token string whole");
        c += 1;
    }
    // Same with an unterminated comment and a long number.
    deref buf[1] = 47;
    deref buf[2] = 42;
    agree(buf, 3000, 0, 2, 1, 100, "max_token comment");
    agree(buf, 3000, 0, 2, 0 - 33, 0, "unterminated comment");
    i = 1;
    while (i < 3000) {
        deref buf[i] = 49;
        i += 1;
    }
    agree(buf, 3000, 0, 0, 1, 0, "long number");
    agree(buf, 3000, 0, 0, 64, 0, "long number chunked");
    mem_free(buf, 4096);
    // Number longer than 65536 bytes.
    var big: ptr<u8> = mem_alloc(70000);
    var j: i64 = 0;
    while (j < 70000) {
        deref big[j] = 55;
        j += 1;
    }
    agree(big, 70000, 0, 0, 0 - 20000, 0, "number over the limit");
    agree(big, 65536, 0, 0, 0 - 20000, 0, "number at the limit");
    agree(big, 65537, 0, 0, 0 - 20000, 0, "number just over the limit");
    mem_free(big, 70000);
}

// ---- random JSON ---------------------------------------------------------------------

fun put(buf: ptr<u8>, at: i64, c: u8) -> i64 {
    deref buf[at] = c;
    return at + 1;
}

fun put_str(buf: ptr<u8>, at: i64, s: str) -> i64 {
    var p: ptr<u8> = s as ptr<u8>;
    var i: i64 = 0;
    var n: i64 = at;
    while (p[i] != 0) {
        deref buf[n] = p[i];
        n += 1;
        i += 1;
    }
    return n;
}

fun put_ws(buf: ptr<u8>, at: i64, flags: u32) -> i64 {
    var n: i64 = at;
    var k: u64 = below(6);
    if (k == 0) {
        n = put(buf, n, 32);
    } else if (k == 1) {
        n = put(buf, n, 10);
    } else if (k == 2) {
        n = put_str(buf, n, " \t\r\n");
    } else if (k == 3 && (flags & 2) != 0) {
        n = put_str(buf, n, "/* c */");
    } else if (k == 4 && (flags & 2) != 0) {
        n = put_str(buf, n, "// c\n");
    }
    return n;
}

fun put_string(buf: ptr<u8>, at: i64) -> i64 {
    var n: i64 = put(buf, at, 34);
    var len: u64 = below(12);
    var i: u64 = 0;
    while (i < len) {
        var k: u64 = below(14);
        if (k < 6) {
            n = put(buf, n, (97 + below(26)) as u8);
        } else if (k == 6) {
            n = put_str(buf, n, "\\n");
        } else if (k == 7) {
            n = put_str(buf, n, "\\\"");
        } else if (k == 8) {
            n = put_str(buf, n, "\\\\");
        } else if (k == 9) {
            n = put_str(buf, n, "\\u00e9");
        } else if (k == 10) {
            n = put_str(buf, n, "\\ud83d\\ude00");
        } else if (k == 11) {
            n = put_str(buf, n, "é");
        } else if (k == 12) {
            n = put_str(buf, n, "😀");
        } else {
            n = put_str(buf, n, "\\u0000");
        }
        i += 1;
    }
    return put(buf, n, 34);
}

fun put_number(buf: ptr<u8>, at: i64) -> i64 {
    var n: i64 = at;
    if (below(3) == 0) {
        n = put(buf, n, 45);
    }
    if (below(5) == 0) {
        n = put(buf, n, 48);
    } else {
        n = put(buf, n, (49 + below(9)) as u8);
        var d: u64 = below(8);
        while (d > 0) {
            n = put(buf, n, (48 + below(10)) as u8);
            d -= 1;
        }
    }
    if (below(3) == 0) {
        n = put(buf, n, 46);
        var f: u64 = 1 + below(6);
        while (f > 0) {
            n = put(buf, n, (48 + below(10)) as u8);
            f -= 1;
        }
    }
    if (below(4) == 0) {
        n = put(buf, n, 101);
        if (below(2) == 0) {
            n = put(buf, n, 45);
        } else if (below(2) == 0) {
            n = put(buf, n, 43);
        }
        n = put(buf, n, (48 + below(10)) as u8);
        if (below(2) == 0) {
            n = put(buf, n, (48 + below(10)) as u8);
        }
    }
    return n;
}

fun put_value(buf: ptr<u8>, at: i64, depth: i32, flags: u32) -> i64 {
    var n: i64 = at;
    var k: u64 = below(10);
    if (depth >= 6 && k >= 6) {
        k = below(6);
    }
    if (k == 0) {
        return put_str(buf, n, "null");
    }
    if (k == 1) {
        if (below(2) == 0) {
            return put_str(buf, n, "true");
        }
        return put_str(buf, n, "false");
    }
    if (k == 2 || k == 3) {
        return put_number(buf, n);
    }
    if (k == 4 || k == 5) {
        return put_string(buf, n);
    }
    var arr: bool = k < 8;
    if (arr) {
        n = put(buf, n, 91);
    } else {
        n = put(buf, n, 123);
    }
    var count: u64 = below(5);
    var i: u64 = 0;
    while (i < count) {
        n = put_ws(buf, n, flags);
        if (!arr) {
            n = put_string(buf, n);
            n = put_ws(buf, n, flags);
            n = put(buf, n, 58);
            n = put_ws(buf, n, flags);
        }
        n = put_value(buf, n, depth + 1, flags);
        n = put_ws(buf, n, flags);
        if (i + 1 < count) {
            n = put(buf, n, 44);
        } else if ((flags & 1) != 0 && below(2) == 0) {
            n = put(buf, n, 44);
        }
        i += 1;
    }
    n = put_ws(buf, n, flags);
    if (arr) {
        return put(buf, n, 93);
    }
    return put(buf, n, 125);
}

fun test_random(iters: i32) {
    var buf: ptr<u8> = mem_alloc(65536);
    var i: i32 = 0;
    while (i < iters) {
        var flags: u32 = below(8) as u32;
        var n: i64 = put_ws(buf, 0, flags);
        n = put_value(buf, n, 0, flags);
        n = put_ws(buf, n, flags);
        if ((flags & 4) != 0) {
            var more: u64 = below(4);
            while (more > 0) {
                n = put_ws(buf, n, flags);
                n = put(buf, n, 10);
                n = put_value(buf, n, 0, flags);
                more -= 1;
            }
        }
        var depth: i32 = 0;
        var dk: u64 = below(6);
        if (dk == 0) {
            depth = 3;
        } else if (dk == 1) {
            depth = 1;
        }
        agree_all(buf, n, depth, flags, "random valid");
        var damage: u64 = below(7);
        if (damage == 0 && n > 0) {
            deref buf[below(n as u64) as i64] = below(256) as u8;
        } else if (damage == 1 && n > 0) {
            n = below(n as u64) as i64;
        } else if (damage == 2 && n > 0) {
            var at: i64 = below(n as u64) as i64;
            var j: i64 = at;
            while (j + 1 < n) {
                deref buf[j] = buf[j + 1];
                j += 1;
            }
            n -= 1;
        } else if (damage == 3 && n > 0) {
            var at2: i64 = below((n + 1) as u64) as i64;
            var j2: i64 = n;
            while (j2 > at2) {
                deref buf[j2] = buf[j2 - 1];
                j2 -= 1;
            }
            var pool: str = "{}[],:\"\\/*-+.eE0aunl \n\x01\x80\xff";
            var pp: ptr<u8> = pool as ptr<u8>;
            deref buf[at2] = pp[below(len_of(pool) as u64) as i64];
            n += 1;
        } else if (damage == 4) {
            n = below(40) as i64;
            var m: i64 = 0;
            while (m < n) {
                deref buf[m] = below(256) as u8;
                m += 1;
            }
        }
        agree_all(buf, n, depth, flags, "random damaged");
        i += 1;
    }
    mem_free(buf, 65536);
}

fun main() -> i32 {
    var iters: i32 = 3000;
    var p: ptr<u8> = c_getenv("WJSON_FUZZ_ITERS" as ptr<u8>);
    if (p != null) {
        var x: i32 = 0;
        var k: i64 = 0;
        while (p[k] >= 48 && p[k] <= 57) {
            x = x * 10 + ((p[k] - 48) as i32);
            k += 1;
        }
        if (x > 0) {
            iters = x;
        }
    }
    // Bad arguments.
    var r: ptr<u8> = ffi_reader_new(0, 0);
    var w: CoreReader = core_reader_new(0, 0);
    check(ffi_reader_feed(r, null, 4) == core_reader_feed(&w, null, 4), "null data");
    check(ffi_reader_feed(r, "x" as ptr<u8>, 0 - 1) == core_reader_feed(&w, "x" as ptr<u8>, 0 - 1), "negative length");
    check(ffi_reader_feed(r, null, 0) == core_reader_feed(&w, null, 0), "empty feed");
    check(ffi_reader_next(r) == core_reader_next(&w), "empty reader");
    ffi_reader_free(r);
    core_reader_free(&w);

    test_fixed();
    test_depth();
    test_max_token();
    test_random(iters);
    println("core_stream_test: {}/{} checks passed", CHECKS - FAILURES, CHECKS);
    if (FAILURES != 0) {
        println("core_stream_test: {} FAILED", FAILURES);
        return 1;
    }
    return 0;
}
