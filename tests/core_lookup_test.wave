// SPDX-License-Identifier: MPL-2.0
//
// Differential test for key lookup and JSON Pointer in the pure-Wave document
// model (src/core_dom.wave) against the Rust core (core/src/dom.rs, reached
// through its C ABI): same node for every key (duplicate keys resolve to the
// last one, large objects use the hash index) and for every pointer.
// Run from the repository root:  wavec run build.wave

import("std::mem::alloc")::{mem_alloc, mem_free};
extern(c, "getenv") fun c_getenv(name: ptr<u8>) -> ptr<u8>;
import("wjson::ffi_rust")::{
    ffi_parse, ffi_free, ffi_ok, ffi_root, ffi_node_count, ffi_type, ffi_len, ffi_at, ffi_key,
    ffi_get, ffi_pointer,
};
import("wjson::core_dom")::{CoreDoc, core_doc_release, core_get, core_pointer};
import("wjson::core_parse")::{core_parse};

static CHECKS: i64 = 0;
static FAILURES: i64 = 0;
static RNG: u64 = 88172645463325252;

fun check(cond: bool, label: str) {
    CHECKS += 1;
    if (!cond) {
        FAILURES += 1;
        if (FAILURES <= 20) {
            println("FAIL: {}", label);
        }
    }
}

fun next() -> u64 {
    var x: u64 = RNG;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    RNG = x;
    return x * 2685821657736338717;
}

fun below(n: u64) -> u64 {
    return (next() >> 11) % n;
}

fun len_of(s: str) -> i64 {
    var p: ptr<u8> = s as ptr<u8>;
    var n: i64 = 0;
    while (p[n] != 0) {
        n += 1;
    }
    return n;
}

// A small pool of keys, so objects get duplicates and hits are common.
fun key_text(k: u64) -> str {
    var pool: array<str, 24> = [
        "a", "b", "c", "id", "name", "", "~", "/", "a/b", "a~b", "key with space", "é",
        "日本", "0", "1", "10", "01", "-", "x", "y", "z", "long_key_number_one", "long_key_number_two", "A"
    ];
    return pool[k as i32];
}

fun put(buf: ptr<u8>, at: i64, c: u8) -> i64 {
    deref buf[at] = c;
    return at + 1;
}

fun put_str(buf: ptr<u8>, at: i64, s: str) -> i64 {
    var p: ptr<u8> = s as ptr<u8>;
    var i: i64 = 0;
    var n: i64 = at;
    while (p[i] != 0) {
        deref buf[n] = p[i];
        n += 1;
        i += 1;
    }
    return n;
}

fun put_value(buf: ptr<u8>, at: i64, depth: i32) -> i64 {
    var n: i64 = at;
    var k: u64 = below(10);
    if (depth >= 4 && k >= 6) {
        k = below(6);
    }
    if (k == 0) {
        return put_str(buf, n, "null");
    }
    if (k == 1) {
        return put_str(buf, n, "true");
    }
    if (k == 2 || k == 3) {
        return put_str(buf, n, "12.5");
    }
    if (k == 4 || k == 5) {
        return put_str(buf, n, "\"s\"");
    }
    var arr: bool = k < 8;
    var count: u64 = below(8);
    if (!arr && below(3) == 0) {
        count = 12 + below(30);       // large objects: crosses the index threshold (16)
    }
    if (arr) {
        n = put(buf, n, 91);
    } else {
        n = put(buf, n, 123);
    }
    var i: u64 = 0;
    while (i < count) {
        if (!arr) {
            n = put(buf, n, 34);
            n = put_str(buf, n, key_text(below(24)));
            n = put_str(buf, n, "\":");
        }
        n = put_value(buf, n, depth + 1);
        if (i + 1 < count) {
            n = put(buf, n, 44);
        }
        i += 1;
    }
    if (arr) {
        return put(buf, n, 93);
    }
    return put(buf, n, 125);
}

// Appends a JSON Pointer reference token for `text` ('~' -> "~0", '/' -> "~1").
fun put_token(buf: ptr<u8>, at: i64, text: ptr<u8>, n: i64) -> i64 {
    var at2: i64 = put(buf, at, 47);
    var i: i64 = 0;
    while (i < n) {
        if (text[i] == 126) {
            at2 = put_str(buf, at2, "~0");
        } else if (text[i] == 47) {
            at2 = put_str(buf, at2, "~1");
        } else {
            at2 = put(buf, at2, text[i]);
        }
        i += 1;
    }
    return at2;
}

fun put_num(buf: ptr<u8>, at: i64, v: i64) -> i64 {
    var tmp: array<u8, 24>;
    var n: i32 = 0;
    var x: i64 = v;
    var more: bool = true;
    while (more) {
        tmp[n] = (48 + (x % 10)) as u8;
        n += 1;
        x = x / 10;
        more = x != 0;
    }
    var o: i64 = at;
    while (n > 0) {
        n -= 1;
        o = put(buf, o, tmp[n]);
    }
    return o;
}

fun agree_get(r: ptr<u8>, d: ptr<CoreDoc>, node: i32, key: ptr<u8>, klen: i64) {
    check(ffi_get(r, node, key, klen) == core_get(d, node, key, klen), "get");
}

fun agree_pointer(r: ptr<u8>, d: ptr<CoreDoc>, node: i32, p: ptr<u8>, n: i64) {
    var a: i32 = ffi_pointer(r, node, p, n);
    var b: i32 = core_pointer(d, node, p, n);
    check(a == b, "pointer");
    if (a != b && FAILURES <= 20) {
        println("   pointer '{}' from node {}: rust {} wave {}", p as str, node, a, b);
    }
}

// A pointer made by walking the document randomly, so most of them resolve.
fun walk_pointer(r: ptr<u8>, node: i32, buf: ptr<u8>) -> i64 {
    var n: i64 = 0;
    var cur: i32 = node;
    var steps: u64 = below(6);
    while (steps > 0) {
        var t: i32 = ffi_type(r, cur);
        var len: i64 = ffi_len(r, cur);
        if ((t != 4 && t != 5) || len <= 0) {
            break;
        }
        var i: i64 = below(len as u64) as i64;
        if (t == 5) {
            var kl: i64 = 0;
            var kp: ptr<u8> = ffi_key(r, cur, i, &kl);
            n = put_token(buf, n, kp, kl);
        } else {
            n = put(buf, n, 47);
            n = put_num(buf, n, i);
        }
        cur = ffi_at(r, cur, i);
        steps -= 1;
    }
    deref buf[n] = 0;
    return n;
}

fun test_doc(src: ptr<u8>, n: i64, scratch: ptr<u8>) {
    var r: ptr<u8> = ffi_parse(src, n, 0, 0);
    var d: CoreDoc = core_parse(src, n, 0, 0);
    if (ffi_ok(r) != 1 || d.err_code != 0) {
        check(ffi_ok(r) != 1 && d.err_code != 0, "both reject");
        ffi_free(r);
        core_doc_release(&d);
        return;
    }
    var count: i32 = ffi_node_count(r) as i32;
    var id: i32 = 0;
    while (id < count) {
        var t: i32 = ffi_type(r, id);
        if (t == 5) {
            var len: i64 = ffi_len(r, id);
            var i: i64 = 0;
            while (i < len) {
                var kl: i64 = 0;
                var kp: ptr<u8> = ffi_key(r, id, i, &kl);
                agree_get(r, &d, id, kp, kl);                       // an existing key (maybe a duplicate)
                i += 1;
            }
            var j: u64 = 0;
            while (j < 24) {                                         // the whole pool: hits and misses
                var ks: str = key_text(j);
                agree_get(r, &d, id, ks as ptr<u8>, len_of(ks));
                j += 1;
            }
            agree_get(r, &d, id, "zzz" as ptr<u8>, 3);
            agree_get(r, &d, id, null, 0);
        } else {
            agree_get(r, &d, id, "a" as ptr<u8>, 1);                 // not an object
        }
        if (t == 4 || t == 5) {
            var p: i32 = 0;
            while (p < 3) {
                var pn: i64 = walk_pointer(r, id, scratch);
                agree_pointer(r, &d, id, scratch, pn);
                p += 1;
            }
        }
        id += 1;
    }
    // Hand-made pointers from the root, including the awkward ones.
    var root: i32 = ffi_root(r);
    var odd: array<str, 22> = [
        "", "/", "//", "/a", "/a/", "/0", "/00", "/01", "/-", "/1", "/10", "/999999999999999999",
        "/9999999999999999999", "a", "/~", "/~0", "/~1", "/~2", "/a~1b", "/a~0b", "/~01", "/é"
    ];
    var o: i32 = 0;
    while (o < 22) {
        var s: str = odd[o];
        agree_pointer(r, &d, root, s as ptr<u8>, len_of(s));
        agree_pointer(r, &d, root, s as ptr<u8>, 0 - 1);
        o += 1;
    }
    agree_pointer(r, &d, root, null, 0);
    agree_pointer(r, &d, root, null, 3);
    agree_pointer(r, &d, 0 - 1, "/a" as ptr<u8>, 2);
    agree_pointer(r, &d, count, "/a" as ptr<u8>, 2);
    ffi_free(r);
    core_doc_release(&d);
}

fun main() -> i32 {
    var iters: i32 = 3000;
    var p: ptr<u8> = c_getenv("WJSON_FUZZ_ITERS" as ptr<u8>);
    if (p != null) {
        var x: i32 = 0;
        var k: i64 = 0;
        while (p[k] >= 48 && p[k] <= 57) {
            x = x * 10 + ((p[k] - 48) as i32);
            k += 1;
        }
        if (x > 0) {
            iters = x;
        }
    }
    var buf: ptr<u8> = mem_alloc(1048576);
    var scratch: ptr<u8> = mem_alloc(4096);
    var i: i32 = 0;
    while (i < iters) {
        var n: i64 = put_value(buf, 0, 0);
        test_doc(buf, n, scratch);
        i += 1;
    }
    mem_free(buf, 1048576);
    mem_free(scratch, 4096);
    println("core_lookup_test: {}/{} checks passed", CHECKS - FAILURES, CHECKS);
    if (FAILURES != 0) {
        println("core_lookup_test: {} FAILED", FAILURES);
        return 1;
    }
    return 0;
}
