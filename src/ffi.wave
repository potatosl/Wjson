// SPDX-License-Identifier: MPL-2.0
//
// Raw C ABI bindings for wjson.
//
//   ffi_backend.wave : documents, editing and readers, on top of the pure Wave
//            core_*.wave. ffi_rust.wave is the same on top of the Rust core
//            (reference for the tests, and the backend chosen for unoptimized
//            builds).
//   num_* / esc_* : pure Wave (number.wave, escape.wave) — number conversion,
//                   string escaping and UTF-8 checks. The C++ versions in
//                   native/src/*.cpp (wjn_*) remain for C and C++ users and as
//                   the reference the Wave tests compare against.
//
// Wave keeps `extern(c)` declarations private to their module, so this file
// re-exposes each one as a thin `pub fun`. Higher-level modules import these
// wrappers and never declare foreign symbols themselves.

import("./number")::{num_parse_f64, num_parse_i64, num_format_f64, num_format_f64_fixed, num_format_i64};
import("./escape")::{esc_escape, esc_utf8_check, esc_utf8_count};


// ---- Documents, editing and readers (src/ffi_backend.wave) -------------------

pub import("./ffi_backend")::{
    ffi_version, ffi_parse, ffi_free, ffi_ok,
    ffi_error_code, ffi_error_message, ffi_error_offset, ffi_error_line,
    ffi_error_column, ffi_root, ffi_node_count, ffi_type,
    ffi_bool, ffi_len, ffi_at, ffi_key,
    ffi_get, ffi_pointer, ffi_str, ffi_num,
    ffi_num_is_int, ffi_new_doc, ffi_new_null, ffi_new_bool,
    ffi_new_number, ffi_new_string, ffi_new_array, ffi_new_object,
    ffi_set_root, ffi_parent, ffi_arr_push, ffi_arr_insert,
    ffi_arr_set, ffi_arr_remove, ffi_obj_set, ffi_obj_clear,
    ffi_obj_remove, ffi_copy, ffi_reader_new, ffi_reader_free,
    ffi_reader_set_max_token, ffi_reader_feed, ffi_reader_finish, ffi_reader_next,
    ffi_reader_text, ffi_reader_depth, ffi_reader_documents, ffi_reader_buffered,
    ffi_reader_error_code, ffi_reader_error_message, ffi_reader_error_offset, ffi_reader_error_line,
    ffi_reader_error_column,
};

// ---- Numbers, strings and UTF-8 (pure Wave) -----------------------------------

pub fun ffi_parse_f64(src: ptr<u8>, len: i64, value: ptr<f64>) -> i32 {
    return num_parse_f64(src, len, value);
}
pub fun ffi_parse_i64(src: ptr<u8>, len: i64, value: ptr<i64>) -> i32 {
    return num_parse_i64(src, len, value);
}
pub fun ffi_format_f64(value: f64, dst: ptr<u8>, cap: i64) -> i64 {
    return num_format_f64(value, dst, cap);
}
pub fun ffi_format_f64_fixed(value: f64, precision: i32, dst: ptr<u8>, cap: i64) -> i64 {
    return num_format_f64_fixed(value, precision, dst, cap);
}
pub fun ffi_format_i64(value: i64, dst: ptr<u8>, cap: i64) -> i64 {
    return num_format_i64(value, dst, cap);
}
pub fun ffi_escape(src: ptr<u8>, len: i64, dst: ptr<u8>, cap: i64, flags: u32) -> i64 {
    return esc_escape(src, len, dst, cap, flags);
}
pub fun ffi_utf8_check(src: ptr<u8>, len: i64) -> i64 { return esc_utf8_check(src, len); }
pub fun ffi_utf8_count(src: ptr<u8>, len: i64) -> i64 { return esc_utf8_count(src, len); }

// ---- C++ native (Windows console only) -----------------------------------------

extern(c, "wjn_console_utf8") fun c_wjn_console_utf8() -> i32;

pub fun ffi_console_utf8() -> i32 { return c_wjn_console_utf8(); }
