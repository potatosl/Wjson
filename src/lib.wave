    JSON_ERR_TRAILING_DATA, JSON_ERR_TOO_DEEP, JSON_ERR_TOO_LARGE, JSON_ERR_INVALID_ARGUMENT,
    JSON_NUM_OK, JSON_NUM_INVALID, JSON_NUM_RANGE, JSON_NUM_NONFINITE,
    JSON_ESCAPE_DEFAULT, JSON_ESCAPE_ASCII, JSON_ESCAPE_HTML,
    JSON_EV_ERROR, JSON_EV_NEED_MORE, JSON_EV_OBJECT_START, JSON_EV_OBJECT_END,
    JSON_EV_ARRAY_START, JSON_EV_ARRAY_END, JSON_EV_KEY, JSON_EV_STRING, JSON_EV_NUMBER,
    JSON_EV_TRUE, JSON_EV_FALSE, JSON_EV_NULL, JSON_EV_END, JSON_STREAM_MULTI,
    JSON_EDIT_OK, JSON_EDIT_INVALID, JSON_EDIT_ATTACHED, JSON_EDIT_CYCLE,
    JSON_EDIT_NOT_FOUND, JSON_EDIT_WRONG_TYPE, JSON_EDIT_BAD_VALUE, JSON_EDIT_TOO_DEEP,
    JSON_WRITER_OK, JSON_WRITER_ERR_STATE, JSON_WRITER_ERR_ALLOC, JSON_WRITER_ERR_NUMBER,
    JSON_WRITER_ERR_UTF8, JSON_WRITER_ERR_INCOMPLETE, JSON_WRITER_ERR_DEPTH, JSON_MAX_DEPTH_LIMIT,
    json_type_name, json_null_str, json_str_is_null, wjson_console_utf8,
};

