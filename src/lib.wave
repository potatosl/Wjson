// SPDX-License-Identifier: MPL-2.0
//
// wjson — JSON for Wave.
//
// Parsing, the document model, editing, the pull parser, number conversion and
// string escaping are all written in Wave (src/core_*.wave, number.wave,
// escape.wave); the Rust core and the C++ layer remain for C and C++ users and
// as the references the tests compare against. Everything you call lives here:
//
//   import("wjson")::{JsonDoc, Json, json_parse, json_ok, json_root,
//                     json_path, json_as_str, json_free};
//
// Modules:
//   consts : type tags, parse flags, error and status codes
//   value  : parse, inspect, navigate, read scalars
//   path   : dotted path queries ("a.b[0]")
//   writer : streaming JSON writer
//   tree   : serialize parsed values, deep equality, depth
//   edit   : create values, modify objects/arrays, build documents
//   stream : incremental pull parser and file streaming for huge inputs

pub import("./consts")::{
    JSON_INVALID, JSON_NULL, JSON_BOOL, JSON_NUMBER, JSON_STRING, JSON_ARRAY, JSON_OBJECT,
    JSON_STRICT, JSON_ALLOW_TRAILING_COMMAS, JSON_ALLOW_COMMENTS, JSON_RELAXED,
    JSON_OK, JSON_ERR_EMPTY, JSON_ERR_UNEXPECTED_CHAR, JSON_ERR_UNEXPECTED_END,
    JSON_ERR_INVALID_NUMBER, JSON_ERR_INVALID_STRING, JSON_ERR_INVALID_ESCAPE,
